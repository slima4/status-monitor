<?xml version="1.0"?>
<!--
  ClickHouse production config for uptimepage.

  Target: deploy on a 4 GB RAM VM with PostgreSQL + Caddy + uptimepage.
  Default ClickHouse will easily consume 8+ GB; these settings cap it
  around 2 GB so the rest of the stack has room to breathe.

  If you have a larger host (8 GB+), you can remove this file or relax
  max_server_memory_usage upward. Re-evaluate after the fleet exceeds
  10M check results per day.
-->
<clickhouse>
    <!-- Hard cap on total server memory. 2 GB is enough for ~50M rows/day. -->
    <max_server_memory_usage>2000000000</max_server_memory_usage>

    <!-- Mark cache: ClickHouse indexes. 512 MB is generous for our schema. -->
    <mark_cache_size>536870912</mark_cache_size>

    <!-- Uncompressed cache: disable. Our queries hit the same data once,
         caching uncompressed blocks just wastes RAM. -->
    <uncompressed_cache_size>0</uncompressed_cache_size>

    <!-- max_memory_usage is a user-level (profile) setting; ClickHouse 25.8+
         refuses to start if it sits at server-config top level. Per-query
         cap so one bad query can't eat the whole 2 GB. -->
    <profiles>
        <default>
            <max_memory_usage>1500000000</max_memory_usage>
        </default>
    </profiles>

    <!-- Unbounded system logs filled the disk (~12 GB of logs vs ~20 MB of data). -->
    <text_log remove="1"/>
    <trace_log remove="1"/>
    <processors_profile_log remove="1"/>

    <query_log>
        <ttl>event_date + INTERVAL 3 DAY DELETE</ttl>
        <max_size_rows>1048576</max_size_rows>
        <flush_interval_milliseconds>7500</flush_interval_milliseconds>
    </query_log>
    <part_log>
        <ttl>event_date + INTERVAL 3 DAY DELETE</ttl>
        <max_size_rows>1048576</max_size_rows>
        <flush_interval_milliseconds>7500</flush_interval_milliseconds>
    </part_log>
    <metric_log>
        <ttl>event_date + INTERVAL 3 DAY DELETE</ttl>
        <max_size_rows>1048576</max_size_rows>
    </metric_log>
    <asynchronous_metric_log>
        <ttl>event_date + INTERVAL 3 DAY DELETE</ttl>
        <max_size_rows>2097152</max_size_rows>
    </asynchronous_metric_log>
    <query_views_log>
        <ttl>event_date + INTERVAL 3 DAY DELETE</ttl>
        <max_size_rows>1048576</max_size_rows>
    </query_views_log>
    <asynchronous_insert_log>
        <ttl>event_date + INTERVAL 3 DAY DELETE</ttl>
        <max_size_rows>1048576</max_size_rows>
    </asynchronous_insert_log>
</clickhouse>
