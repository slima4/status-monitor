<?xml version="1.0"?>
<!--
  ClickHouse production config for uptimepage.

  ClickHouse defaults assume it owns the machine; here it is co-located
  with Postgres, Caddy, and the app, so these settings bound its memory
  and cache use to leave headroom for the rest of the stack. On a
  dedicated ClickHouse host you can relax or remove these caps.
  Re-evaluate after the fleet exceeds 10M check results per day.
-->
<clickhouse>
    <!-- Hard cap on total server memory so ClickHouse leaves headroom for the co-located services. -->
    <max_server_memory_usage>2000000000</max_server_memory_usage>

    <!-- Mark cache: ClickHouse indexes. 512 MB is generous for our schema. -->
    <mark_cache_size>536870912</mark_cache_size>

    <!-- Uncompressed cache: disable. Our queries hit the same data once,
         caching uncompressed blocks just wastes RAM. -->
    <uncompressed_cache_size>0</uncompressed_cache_size>

    <!-- max_memory_usage is a user-level (profile) setting; ClickHouse 25.8+
         refuses to start if it sits at server-config top level. Per-query
         cap so one bad query can't consume the whole server memory budget. -->
    <profiles>
        <default>
            <max_memory_usage>1500000000</max_memory_usage>
        </default>
    </profiles>

    <!-- Sample async metrics every 60s instead of every second: their
         collection is the main idle-CPU cost (ClickHouse#60016). -->
    <asynchronous_metrics_update_period_s>60</asynchronous_metrics_update_period_s>

    <!-- Built-in Prometheus endpoint on the internal docker network, never
         published to the host so no auth path is exposed. Serves live
         system.metrics, asynchronous_metrics and events, so Grafana sees parts,
         merges, async-insert flushes and memory without reading system.*_log. -->
    <prometheus>
        <endpoint>/metrics</endpoint>
        <port>9363</port>
        <metrics>true</metrics>
        <asynchronous_metrics>true</asynchronous_metrics>
        <events>true</events>
        <errors>true</errors>
    </prometheus>

    <!-- Unbounded system logs filled the disk (12 GB of logs vs 20 MB of data)
         and their writes burn CPU at idle. We observe ClickHouse through Grafana,
         not these tables, so disable them all except query_log and part_log,
         kept bounded for on-hand debugging. remove="1" on an absent table is a
         no-op, so the list stays valid across versions. -->
    <asynchronous_metric_log remove="1"/>
    <asynchronous_insert_log remove="1"/>
    <backup_log remove="1"/>
    <error_log remove="1"/>
    <crash_log remove="1"/>
    <metric_log remove="1"/>
    <query_metric_log remove="1"/>
    <query_thread_log remove="1"/>
    <query_views_log remove="1"/>
    <session_log remove="1"/>
    <text_log remove="1"/>
    <trace_log remove="1"/>
    <opentelemetry_span_log remove="1"/>
    <zookeeper_log remove="1"/>
    <zookeeper_connection_log remove="1"/>
    <aggregated_zookeeper_log remove="1"/>
    <processors_profile_log remove="1"/>
    <latency_log remove="1"/>
    <background_schedule_pool_log remove="1"/>

    <query_log>
        <ttl>event_date + INTERVAL 3 DAY DELETE</ttl>
        <max_size_rows>1048576</max_size_rows>
        <flush_interval_milliseconds>7500</flush_interval_milliseconds>
    </query_log>
    <part_log>
        <ttl>event_date + INTERVAL 3 DAY DELETE</ttl>
        <max_size_rows>1048576</max_size_rows>
        <flush_interval_milliseconds>7500</flush_interval_milliseconds>
    </part_log>
</clickhouse>
