// Grafana Alloy — ship uptimepage metrics to Grafana Cloud.
//
// This runs as an opt-in sidecar in docker-compose.yml under the
// "metrics" profile. The default `docker compose up -d` does NOT start
// it; enable with `docker compose --profile metrics up -d`.
//
// Credentials come only from the container environment (set in .env,
// which is gitignored). Nothing secret is written in this file. The
// `password` argument is a secret-typed value, so Alloy redacts it from
// its own /-/config endpoint and UI.

// Scrape the in-binary Prometheus endpoint over the internal docker
// network. The service binds metrics on 0.0.0.0:9090 inside the
// container (set via UPTIMEPAGE_SERVER__METRICS_BIND in compose) so
// a separate container can reach it; the port is never published to the
// host.
// Both blue/green replicas. Steady state one color is up (the other scrape
// yields up=0, harmless); during a deploy's brief overlap both are up — the
// `color` label keeps their series distinct so they don't collide.
prometheus.scrape "uptimepage" {
  targets = [
    { __address__ = "uptimepage_blue:9090",  color = "blue"  },
    { __address__ = "uptimepage_green:9090", color = "green" },
  ]
  forward_to      = [prometheus.remote_write.grafana_cloud.receiver]
  job_name        = "uptimepage"
  scrape_interval = "15s"
}

// Co-located home-region probe agent (present only under the `agent` compose
// profile). It emits the probe-side latency/throughput the brain can't see;
// an absent agent simply scrapes down, which doubles as a liveness signal.
prometheus.scrape "uptimepage_agent" {
  targets = [
    { __address__ = "agent:9090", role = "home-agent" },
  ]
  forward_to      = [prometheus.remote_write.grafana_cloud.receiver]
  job_name        = "uptimepage_agent"
  scrape_interval = "15s"
}

// Remote-write to Grafana Cloud Prometheus. URL and credentials are
// environment-specific and supplied via the container env:
//   GRAFANA_CLOUD_PROM_URL   e.g. https://prometheus-prod-XX-<zone>.grafana.net/api/prom/push
//   GRAFANA_CLOUD_PROM_USER  the numeric instance / stack id
//   GRAFANA_CLOUD_API_TOKEN  an access policy token with metrics:write
prometheus.remote_write "grafana_cloud" {
  endpoint {
    url = sys.env("GRAFANA_CLOUD_PROM_URL")

    basic_auth {
      username = sys.env("GRAFANA_CLOUD_PROM_USER")
      password = sys.env("GRAFANA_CLOUD_API_TOKEN")
    }
  }

  // Identify this sender so multiple instances don't collide in Grafana
  // Cloud. Driven by GRAFANA_CLOUD_INSTANCE (set per host in .env);
  // falls back to a sane default when unset.
  external_labels = {
    instance = coalesce(sys.env("GRAFANA_CLOUD_INSTANCE"), "uptimepage"),
  }
}

// ---------------------------------------------------------------------
// Logs → Grafana Cloud Loki (opt-in; INERT until the LOKI_* env is set).
//
// Tails the application container's stdout/stderr through the Docker
// API and ships it to Grafana Cloud Loki. Container discovery needs the
// Docker socket, mounted read-only into this sidecar in
// docker-compose.yml. Only the uptimepage container is shipped — a
// discovery.relabel `keep` drops postgres / clickhouse / caddy / alloy
// so Loki ingest stays scoped and cheap.
//
// Inert by design: when GRAFANA_CLOUD_LOKI_URL is unset the write
// endpoint resolves to an unreachable loopback placeholder, so the
// pipeline just fails fast and drops batches (bounded retry/backoff).
// The metrics pipeline above is a wholly independent graph and is never
// affected. To activate: set the LOKI_* env (deploy-managed, same .env
// contract as metrics) AND add the `logs:write` scope to the shared
// access-policy token.
//   GRAFANA_CLOUD_LOKI_URL   e.g. https://logs-prod-XX.grafana.net/loki/api/v1/push
//   GRAFANA_CLOUD_LOKI_USER  the numeric Loki instance / stack id
//   GRAFANA_CLOUD_API_TOKEN  the SAME token as metrics, with logs:write added

discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
  // Containers don't churn on this single box — poll slowly so the
  // (effectively host-root) Docker API call isn't made every 60s.
  refresh_interval = "5m"
}

// Keep ONLY the app container (compose service label is exact and
// survives a project/container rename); tidy the noisy docker meta
// labels down to stable {container,job} before the logs are shipped.
discovery.relabel "uptimepage_only" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    regex         = "uptimepage_(blue|green)"
    action        = "keep"
  }

  // Collapse both colors under one container label so blue/green don't split
  // the Loki stream — they are the same logical app.
  rule {
    target_label = "container"
    replacement  = "uptimepage"
  }

  rule {
    target_label = "job"
    replacement  = "uptimepage"
  }
}

loki.source.docker "uptimepage" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.uptimepage_only.output
  labels     = {}
  forward_to = [loki.write.grafana_cloud.receiver]
}

loki.write "grafana_cloud" {
  endpoint {
    // Unreachable placeholder when unset → pipeline inert, metrics safe.
    url = coalesce(sys.env("GRAFANA_CLOUD_LOKI_URL"), "http://127.0.0.1:1/loki/api/v1/push")

    basic_auth {
      username = coalesce(sys.env("GRAFANA_CLOUD_LOKI_USER"), "0")
      password = coalesce(sys.env("GRAFANA_CLOUD_API_TOKEN"), "unset")
    }
  }

  external_labels = {
    instance = coalesce(sys.env("GRAFANA_CLOUD_INSTANCE"), "uptimepage"),
  }
}
