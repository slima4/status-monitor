  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Operator metrics for status-monitor. Single-instance: no org_id label (operator-only). Histograms are exposed as Prometheus summaries by metrics-exporter-prometheus (quantile labels), so latency panels read {quantile=...} directly rather than histogram_quantile().",
