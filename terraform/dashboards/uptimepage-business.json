          "expr": "max by (kind) (uptimepage_notification_channels) > 0 unless on (kind) label_replace(sum by (transport) (increase(uptimepage_notifications_total{outcome=\"sent\"}[$__range])) > 0, \"kind\", \"$1\", \"transport\", \"(.*)\")",
